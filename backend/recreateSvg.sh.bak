#!/usr/bin/env bash
set -euo pipefail

INPUT="$1"

if [[ -z "${INPUT:-}" ]]; then
  echo "Uso: ./bach.sh logo.png"
  exit 1
fi

if [[ ! -f "$INPUT" ]]; then
  echo "Arquivo não encontrado: $INPUT"
  exit 1
fi

# Detecta ImageMagick
if command -v magick >/dev/null 2>&1; then
  IM="magick"
elif command -v convert >/dev/null 2>&1; then
  IM="convert"
else
  echo "❌ ImageMagick não encontrado (magick/convert)"
  exit 1
fi

NAME=$(basename "$INPUT" .png)

WORKDIR="work_${NAME}"
LAYERS="${WORKDIR}/layers"
BW="${WORKDIR}/bw_layers"
SVGS="${WORKDIR}/svg_layers"

mkdir -p "$LAYERS" "$BW" "$SVGS"

echo "[1/5] Separando cores (sem blur)…"
$IM "$INPUT" \
  -alpha off \
  -colors 6 \
  -dither None \
  "$LAYERS/layer_%02d.png"

echo "[2/5] Convertendo camadas para PB…"
for img in "$LAYERS"/*.png; do
  base=$(basename "$img" .png)

  $IM "$img" \
    -colorspace Gray \
    -threshold 50% \
    "$BW/${base}_bw.png"
done

echo "[3/5] Vetorizando com potrace…"
for img in "$BW"/*.png; do
  base=$(basename "$img" _bw.png)

  potrace "$img" \
    --svg \
    --turdsize 5 \
    --alphamax 0 \
    --opttolerance 0 \
    -o "$SVGS/${base}.svg"
done

echo "[4/5] Unindo SVGs…"
svg_stack "$SVGS"/*.svg > "$WORKDIR/${NAME}_merged.svg"

echo "[5/5] Otimizando SVG final…"
svgo "$WORKDIR/${NAME}_merged.svg" \
  --multipass \
  --disable=removeViewBox \
  -o "${NAME}.svg"

echo
echo "✅ SVG FINAL GERADO:"
echo "👉 ${NAME}.svg"
